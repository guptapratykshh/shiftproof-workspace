# FRONTEND ONLY: leave blank for a static preview with explicit unavailable API states.
# npm run dev:full supplies /api/v1 automatically. Docker builds use /api/v1.
# Never store provider credentials in VITE_ variables (they are public build output).
VITE_API_BASE_URL=
# Use poll for temporary public tunnels that cannot stream live updates.
# Leave blank for the normal server-sent event connection.
VITE_LIVE_UPDATES=

# Optional local Docker overrides. Native API configuration uses backend/.env instead.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/shiftproof?retryWrites=true&w=majority
# Production template and instructions: deploy/production.env.example, docs/deployment.md.
