# Copy to the repository root .env on the deployment host; protect it with chmod 600.
# Replace placeholders before starting; never commit real credentials.
SITE_DOMAIN=shiftproof.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=ShiftProof <noreply@shiftproof.example.com>
# API/worker production mode, secure cookies and HTTPS origin are forced by compose.production.yaml.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STORAGE_MODE=local
# Optional S3: configure private bucket, server encryption, credentials and backup policy.
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# PDF support: mount updated ClamAV definitions and set /usr/bin/clamscan, or provide a compatible executable.
MALWARE_SCANNER=
