APP_ENV=development
DATABASE_URL=sqlite:///./data/shiftproof.db
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
SESSION_HOURS=12
WORKER_SESSION_HOURS=8
# Development delivery writes private email files to data/outbox; production requires SMTP.
MAIL_MODE=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=ShiftProof <noreply@shiftproof.local>
STORAGE_MODE=local
STORAGE_DIRECTORY=./data/evidence
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PDF uploads require an up-to-date configured scanner executable. Blank means reject PDFs.
MALWARE_SCANNER=
